# Copy to host/.env. This file configures the tools that run on your own
# machine (next to Ollama), not the NAS.

# Where the shelly-chat server is. Locally the API of `docker compose up`;
# for production https://chat.shelly-nas.nl, for acc https://chat-acc.shelly-nas.nl
# (or http:// when the NAS serves plain HTTP).
SHELLY_CHAT_URL=http://localhost:3000
# Same value as INDEX_TOKEN on the NAS (empty locally unless you set one).
INDEX_TOKEN=

# Ollama on this machine.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:latest
EMBED_BATCH_SIZE=16

# Chunking. A change here (or of EMBED_MODEL) rebuilds the index on the next run.
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=300

# Sources: comma-separated GitLab URLs. Prefix an entry with # to skip it.
GITLAB_WIKI_URLS=
GITLAB_REPO_URLS=
# Personal Access Token with read_wiki and read_repository.
GITLAB_PAT=
