# Copy to host/.env. This file configures the tools that run on your own
# machine (next to Ollama), not the NAS. Most people index from the Index
# screen in the app instead; this is for the command line.

# Where the shelly-chat server is: http://chat-acc.shelly-nas.nl,
# http://chat.shelly-nas.nl, or http://localhost:3000 for docker compose.
SHELLY_CHAT_URL=http://localhost:3000
# Same value as INDEX_TOKEN on the NAS (empty locally unless you set one).
INDEX_TOKEN=

# Ollama on this machine.
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:latest
EMBED_BATCH_SIZE=16

# The documents and the sources (folders in the documents folder) are on the
# NAS and managed on the Index screen; chunk sizes are set there too.
