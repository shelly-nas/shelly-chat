# Copy to .env and fill in. docker compose refuses to start without DB_PASSWORD,
# which is deliberate: credentials do not belong in the compose file or the SQL,
# where they end up in the git history.
DB_USER=chat
DB_PASSWORD=
DB_NAME=chat

# Folder the server may read documents from; index sources lie inside it.
# Locally ./documents. On the NAS empty means / (the whole NAS), so a source
# can be any absolute path; set a folder to limit it, e.g. /volume1/Documenten.
DOCUMENTS_DIR=

# Token the indexer (host/) sends to change the index. May stay empty locally;
# required on acc and in production. Generate one with: openssl rand -hex 32
INDEX_TOKEN=

# Defaults for the browser, which talks to Ollama on the user's own machine.
# Each user can override the model in the app's settings.
LLM_MODEL_NAME=gemma4:latest
# Defaults for the shared settings; changed in the app under Instellingen.
# Empty uses the Dutch defaults in server/app/config.py.
LLM_SYSTEM_PROMPT=
NO_ANSWER_RESPONSE=
